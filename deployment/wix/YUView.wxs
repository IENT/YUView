<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="YUView"
           Manufacturer="IENT RWTH Aachen University"
           Version="$(ProductVersion)"
           UpgradeCode="07fd1dd5-9b1e-453d-974b-4ff7919a49c7"
           Language="1033"
           InstallerVersion="500"
           Scope="perMachine"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="APPLICATIONFOLDER" Name="YUView" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="YUView" />
    </StandardDirectory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="6B14ED57-BCD5-45CB-84C3-E822D9F5950B">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="YUView"
                  Description="YUV Viewer and Analysis Tool"
                  Target="[APPLICATIONFOLDER]YUView.exe"
                  WorkingDirectory="APPLICATIONFOLDER" />
        <RemoveFolder Id="CleanUpShortCut"
                Directory="ApplicationProgramsFolder"
                On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\IENT\YUView"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="YUView" Level="1">
      <ComponentGroupRef Id="FilesComponentGroup" />
      <ComponentRef Id="ApplicationShortcut" />
      <MergeRef Id="VCRedist" />
    </Feature>

    <WixVariable Id="WixUILicenseRtf" Value="YUViewLicense.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="YUViewBanner.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="YUViewBannerTop.bmp" />
    <WixVariable Id="WixUINewIco" Value="YUViewIco.bmp" />
    <ui:WixUI Id="WixUI_Minimal" />

    <Icon Id="YUView.ico" SourceFile="../../YUViewApp/images/YUView.ico" />
    <Property Id="ARPPRODUCTICON" Value="YUView.ico" />
  </Package>

  <Fragment>
    <ComponentGroup Id="FilesComponentGroup">
      <Files Include="!(bindpath.Payload)\**" Directory="APPLICATIONFOLDER" />
    </ComponentGroup>
    <DirectoryRef Id="TARGETDIR">
      <Merge Id="VCRedist"
             SourceFile="Microsoft_VC143_CRT_x64.msm"
             Language="0" />
    </DirectoryRef>
  </Fragment>
</Wix>
