<Project Sdk="WixToolset.Sdk/7.0.1">
  <PropertyGroup>
    <OutputName>YUViewSetup</OutputName>
    <OutputPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\</OutputPath>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>en-US</Cultures>
    <ProductVersion Condition="'$(ProductVersion)' == ''">2.14.1</ProductVersion>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildProjectDirectory)\..\..\deploy</PayloadDir>
    <DefineConstants>ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bundle\**\*.wxs" />
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="7.0.1" />
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.1" />
    <BindPath Include="$(PayloadDir)" BindName="Payload" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.1" />
  </ItemGroup>
</Project>