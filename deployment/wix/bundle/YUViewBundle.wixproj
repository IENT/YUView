<Project Sdk="WixToolset.Sdk/7.0.1">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>YUViewSetup</OutputName>
    <OutputPath>$(MSBuildProjectDirectory)\..\bin\Bundle\$(Configuration)\</OutputPath>
    <Cultures>en-US</Cultures>
    <ProductVersion Condition="'$(ProductVersion)' == ''">2.15</ProductVersion>
    <DefineConstants>ProductVersion=$(ProductVersion);BuildConfiguration=$(Configuration)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="7.0.1" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.1" />
  </ItemGroup>
</Project>