          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;What is the source format of the YUV file? E.g: The subsampling and bit depth. Select one of the predefined formats or select 'custom...' to define a custom format.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="labelISPMode">
         <property name="toolTip">
          <string>ISP mode paints each YUV400 sample as a Bayer false color (R/G/B) for raw sensor preview. Available only for luma-only (YUV400) sources.</string>
         </property>
         <property name="text">
          <string>ISP Mode</string>
         </property>
        </widget>
       </item>
       <item row="1" column="1">
        <layout class="QVBoxLayout" name="ispModeLayout">
         <item>
          <widget class="QCheckBox" name="checkBoxEnableISPMode">
           <property name="enabled">
            <bool>false</bool>
           </property>
           <property name="toolTip">
            <string>Enable Bayer false-color preview for YUV400 (8/10/12/16-bit) sources. Each mosaic sample is shown as red, green, or blue according to the selected Bayer pattern.</string>
           </property>
           <property name="text">
            <string>Enable ISP mode</string>
           </property>
           <property name="checked">
            <bool>false</bool>
           </property>
          </widget>
         </item>
