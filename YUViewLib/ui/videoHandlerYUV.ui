            <bool>false</bool>
           </property>
           <property name="toolTip">
            <string>Select HDR transfer function: PQ (SMPTE ST.2084) for HDR10 content, HLG (ARIB STD-B67) for broadcast HDR, or Linear (scRGB) for pass-through to display.</string>
           </property>
          </widget>
         </item>
         <item>
          <layout class="QHBoxLayout" name="toneMappingLayout">
           <item>
            <widget class="QLabel" name="labelToneMapping">
             <property name="text">
              <string>Tone Mapping</string>
             </property>
             <property name="toolTip">
              <string>Drag the slider to set the target max luminance for ITU-R BT.2390 EETF tone mapping. PQ's 10000 nit range is mapped to the selected brightness.</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QSlider" name="sliderToneMapNits">
             <property name="enabled">
              <bool>false</bool>
             </property>
             <property name="toolTip">
              <string>Target max luminance (500-10000 nits). ITU-R BT.2390 EETF maps PQ highlights to fit this range.</string>
             </property>
             <property name="minimum">
              <number>0</number>
             </property>
             <property name="maximum">
              <number>1000</number>
             </property>
             <property name="singleStep">
              <number>1</number>
             </property>
             <property name="pageStep">
              <number>50</number>
             </property>
             <property name="value">
