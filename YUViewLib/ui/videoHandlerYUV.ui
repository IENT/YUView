           <item>
            <widget class="QLabel" name="labelBayerPattern">
             <property name="text">
              <string>Bayer</string>
             </property>
             <property name="toolTip">
              <string>Camera Bayer mosaic layout starting at the top-left sample (e.g. RGGB).</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QComboBox" name="comboBoxBayerPattern">
             <property name="enabled">
              <bool>false</bool>
             </property>
             <property name="toolTip">
              <string>Select the camera Bayer pattern. Matching samples are painted in that primary color (R/G/B).</string>
             </property>
            </widget>
           </item>
          </layout>
         </item>
         <item>
          <layout class="QHBoxLayout" name="ispCellSizeLayout">
           <item>
            <widget class="QLabel" name="labelISPCellSize">
             <property name="text">
              <string>Cell size</string>
             </property>
             <property name="toolTip">
              <string>Single: classic 1x1 Bayer cell. Quad: each color is a 2x2 block. Nine-in-one: each color is a 3x3 block.</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QComboBox" name="comboBoxISPCellSize">
             <property name="enabled">
              <bool>false</bool>
             </property>
             <property name="toolTip">
              <string>Preview classic Bayer (Single), Quad Bayer / Tetracell (Quad), or Nonacell (Nine-in-one) mosaics.</string>
             </property>
            </widget>
           </item>
          </layout>
         </item>
        </layout>
       </item>
       <item row="5" column="0">
        <widget class="QLabel" name="label_10bit">
         <property name="toolTip">
          <string>Enable HDR display with native 10-bit precision for HDR content. Choose between PQ (HDR10) and HLG transfer functions.</string>
         </property>
         <property name="text">
          <string>HDR Display</string>
         </property>
        </widget>
       </item>
       <item row="5" column="1">
        <layout class="QVBoxLayout" name="hdrDisplayLayout">
