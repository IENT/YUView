          <widget class="QCheckBox" name="checkBoxEnable10BitDisplay">
           <property name="enabled">
            <bool>true</bool>
           </property>
           <property name="toolTip">
            <string>Enable HDR display with native 10-bit precision for HDR content. Requires HDR-capable display and Windows HDR enabled.</string>
           </property>
           <property name="text">
            <string>Enable HDR display</string>
           </property>
           <property name="checked">
